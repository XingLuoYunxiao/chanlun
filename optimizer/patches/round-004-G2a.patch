+# 1 分钟的走势类型」。中枢延伸吸收到 9 段之后已经等价于上一级别的盘整，必须
+# 收口，否则会把「高级别盘整」和「本级别趋势」混成同一个中枢。
+MAX_SEGMENTS = 9
 
 
 def next_level(level: str) -> str:
     """返回上一级别名。未知级别退化为 `"<level>+"`，不做静默猜测。"""
@@ -120,9 +124,10 @@
             continue
 
         # 延伸：后续段只要仍与 [zd, zg] 重叠就并入（且不改变 zd/zg）
         j = i + MIN_SEGMENTS
-        while j < n and _overlaps(confirmed[j], zd, zg):
+        while (j < n and j - i < MAX_SEGMENTS
