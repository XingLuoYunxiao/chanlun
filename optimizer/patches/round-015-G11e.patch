# kind: engineering
# finding: 自选股行把未确认的买卖点显示得和已确认的一模一样（app.js 第742行只印 kind+ts），而页面免责声明只提「笔画与中枢」未确认、没提买卖点；同一份数据在中栏 ledger 里反而标了确认/未确认。
# evidence: cd chanlun && curl -s 'http://127.0.0.1:8888/api/watchlist/structure'  # 4 只自选股里 000002 唯一的信号 s3 2026-09-23 status=tentative confirmed_at=null，自选股行只印「三卖 2026-09-23」无任何未确认标记；同一份数据在中栏 ledger 里是有「未确认」chip 的。另 600030 行印「中枢 未确认 23.39–31.68」+「三买 2025-04-07 @ 22.97」，该三买属于上一个中枢（ZG=20.25），价格低于所印中枢的下沿
diff --git a/src/chanlun/web/static/app.js b/src/chanlun/web/static/app.js
--- a/src/chanlun/web/static/app.js
+++ b/src/chanlun/web/static/app.js
@@ -738,9 +738,13 @@
       const sigs = it.signals || [];
       if (sigs.length) {
         row.classList.add("has-signal");
         const last = sigs[sigs.length - 1];
-        const tag = span("watch-sig", `${KIND_CN[last.kind] || last.kind} ${last.ts}`);
+        const tag = span(
+          "watch-sig",
+          `${KIND_CN[last.kind] || last.kind} ${last.ts}` +
+            (last.status === "tentative" ? "（未确认）" : ""),
+        );
         row.append(top, mid, meta, tag);
         return finishWatchRow(row, it);
       }
     }
