+def _exit_pair(segs: list[Segment],
+               p: Pivot) -> tuple[Segment | None, Segment | None]:
+    """中枢的（离开段, 回试段）。
+
+    离开段是中枢的**最后一根**线段：它从 `[zd, zg]` 内部出发、在区间外结束
+    —— 否则它会被 `find_pivots` 的延伸循环并进中枢。`p.end_idx + 1` 是紧随
+    其后的那一段，与离开段首尾相接且方向必然相反，它就是第 20 课说的
+    「回试/回抽」，不是离开段。
+    """
+    if p.end_idx + 1 >= len(segs):
+        return None, None
+    leave, back = segs[p.end_idx], segs[p.end_idx + 1]
+    # 点内正确性：离开/回试两段都必须已经确认，否则这个三类买卖点在当时
+    # 还不可知（`end_idx + 1` 在入参列表里可能是 TENTATIVE 段）。
+    if leave.status is not Status.CONFIRMED or back.status is not Status.CONFIRMED:
+        return None, None
+    return leave, back
