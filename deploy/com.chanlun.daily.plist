<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  缠论每日流水线：macOS launchd 版（本机是 macOS，没有 systemd）

  安装：本文件里的 __PROJECT_DIR__ / __PYTHON__ 是占位符，**必须先替换成绝对路径**。
  launchd 不展开 `~`、也不展开环境变量，所以不能直接 cp 过去用。
  在**项目根目录**执行（sed 的 # 分隔符是为了避开路径里的 /）：

    sed -e "s#__PROJECT_DIR__#$(pwd)#g" -e "s#__PYTHON__#$(command -v python3)#g" \
        deploy/com.chanlun.daily.plist > ~/Library/LaunchAgents/com.chanlun.daily.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.chanlun.daily.plist
    # 老系统用：launchctl load -w ~/Library/LaunchAgents/com.chanlun.daily.plist

  __PYTHON__ 应当指向**装了本项目依赖的那个解释器**（本机是虚拟环境里的
  .venv-chanlun/bin/python），不一定是 `command -v python3`；换成绝对路径即可。
  sed 之后可以先 `plutil -lint` 校验再装。

  验证 / 手动触发 / 卸载：
    launchctl print gui/$(id -u)/com.chanlun.daily | head -20   # 看状态与下次触发
    launchctl kickstart -p gui/$(id -u)/com.chanlun.daily       # 立刻跑一次
    launchctl bootout gui/$(id -u)/com.chanlun.daily            # 卸载

  时间口径：launchd 用**本机时区**解释 StartCalendarInterval。本机
  /etc/localtime → Asia/Shanghai（CST +0800），所以 17:30 就是国内的 17:30；
  如果哪天把机器时区换成别的，必须回来改这里的 Hour/Minute，launchd 不会替你换算。

  休眠补跑：StartCalendarInterval 错过的触发点，在机器唤醒后补跑一次
  （等价于 systemd 的 Persistent=true）——漏一天就少一天的结构快照，不能接受。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chanlun.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>chanlun</string>
    <string>daily</string>
    <!--
      2026-10-13 起跑 day,5,30。此前那条注释说「再叠加 30 分钟和 5 分钟就是 7 小时」
      —— 那是**按全市场**估的，而**分钟周期的范围从来不是全市场**：
      `_codes_for_period` 给分钟的是「自选池 + 全部指数 + 全部申万板块」，
      现在约 168 个，其中 166 个走**东财**（实测 1.4~2.8 只/秒，约 1 分钟），
      只有自选池里那 2 只 A 股走 baostock（85 秒/只）。所以分钟一轮约 4~5 分钟，
      两个周期合计约 10 分钟，叠在日线的 ~2.3 小时上仍然收得完。

      为什么要跑分钟：**分钟基准的递归要长历史才有产出**（日线基准下 95% 的票
      只出 1 级，实测 400 只沪市：380 只 1 级 / 20 只 2 级），而指数与申万此前
      **完全没有分钟源**，只有每天累积才长得起来。流水线本身支持多周期，
      并会在分钟数据陈旧时自动降级为仅日线。
    -->
    <string>--periods</string>
    <string>day,5,30</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>src</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <!-- 工作日（launchd 里 1=周一 … 5=周五；0 和 7 都是周日）17:30 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <!-- 只按日历触发，加载时不要立刻跑一遍：手动跑一次整轮流水线代价不小 -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/logs/daily.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/logs/daily.log</string>
</dict>
</plist>
