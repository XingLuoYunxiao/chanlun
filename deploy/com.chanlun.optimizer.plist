<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  缠论 24x7 优化器：macOS launchd 版（本机是 macOS，没有 systemd）

  安装：本文件里的 __PROJECT_DIR__ / __PYTHON__ 是占位符，**必须先替换成绝对路径**。
  launchd 不展开 `~`、也不展开环境变量，所以不能直接 cp 过去用。
  在**项目根目录**执行（sed 的 # 分隔符是为了避开路径里的 /）：

    sed -e "s#__PROJECT_DIR__#$(pwd)#g" -e "s#__PYTHON__#$(command -v python3)#g" \
        deploy/com.chanlun.optimizer.plist > ~/Library/LaunchAgents/com.chanlun.optimizer.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.chanlun.optimizer.plist
    # 老系统用：launchctl load -w ~/Library/LaunchAgents/com.chanlun.optimizer.plist

  __PYTHON__ 应当指向**装了本项目依赖的那个解释器**（本机是虚拟环境里的
  .venv-chanlun/bin/python），不一定是 `command -v python3`；换成绝对路径即可。
  sed 之后可以先 `plutil -lint` 校验再装。

  验证 / 手动触发 / 卸载：
    launchctl print gui/$(id -u)/com.chanlun.optimizer | head -20
    tail -f __PROJECT_DIR__/logs/optimizer.log
    launchctl bootout gui/$(id -u)/com.chanlun.optimizer      # 卸载

  熔断（退出码 3）在这边的口径必须说清楚：launchd 的 KeepAlive 只能按
  「是否成功退出」区分，**没法**按退出码放行某一种。所以这里 KeepAlive=true，
  重启是常态；真正拦住无限循环的是优化器自己 —— 熔断会把一条
  `status: circuit_break` 的 journal 记录写进 optimizer/journal/，
  之后每一次启动都会读到它、立刻以 3 退出并在日志里打
  `!!! 熔断 !!!`，ThrottleInterval 保证这种「一起来就退出」不会变成忙等。
  也就是说：systemd 靠 RestartPreventExitStatus=3 停，macOS 靠持久化的熔断记录停，
  两条路都指向同一个事实——不人工 review 就不干活。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chanlun.optimizer</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>optimizer/agent.py</string>
    <string>--root</string>
    <string>__PROJECT_DIR__</string>
    <string>--rounds</string>
    <string>10</string>
    <string>--measure</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>src</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <!-- 跑完一轮就再来一轮：正常退出（0）也要重启 -->
  <key>KeepAlive</key>
  <true/>

  <!-- 熔断状态下「一起来就退出」的最小间隔，避免刷日志 -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/logs/optimizer.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/logs/optimizer.log</string>
</dict>
</plist>
